<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="100dp"
        android:gravity="bottom">

        <Button
            android:id="@+id/quit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:onClick="onClick"
            android:text="退出" />

        <Button
            android:id="@+id/pause"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/quit"
            android:layout_marginBottom="10dp"
            android:onClick="onClick"
            android:text="暂停" />

        <Button
            android:id="@+id/resume"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/pause"
            android:layout_marginBottom="10dp"
            android:onClick="onClick"
            android:text="开始" />
        <Button
            android:id="@+id/analog_start_preview_btn"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/resume"
            android:layout_marginBottom="10dp"
            android:onClick="onClick"
            android:text="开始预览" />

        <TextView
            android:id="@+id/analog_fps_tv"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:layout_above="@id/analog_start_preview_btn"
            android:textColor="@color/bnav_service_dyna_bg_yellow"
            android:text="fps"/>
        <Button
            android:id="@+id/analog_open_mini_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/analog_start_preview_btn"
            android:layout_marginBottom="10dp"
            android:onClick="onClick"
            android:text="多实例地图" />
        <Button
            android:id="@+id/analog_start_hide_mini_btn"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/analog_open_mini_btn"
            android:text="隐藏/显示"
            android:layout_marginBottom="10dp"
            android:onClick="onClick"/>
        <Button
            android:id="@+id/analog_start_voice_mode_btn"
            android:visibility="visible"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@id/analog_start_hide_mini_btn"
            android:text="车机播报"
            android:layout_marginBottom="10dp"
            android:onClick="onClick"/>
         <EditText
             android:id="@+id/analog_mac_et"
             android:layout_above="@id/analog_start_voice_mode_btn"
             android:layout_width="200dp"
             android:layout_height="30dp"
             android:background="#999999"
             android:text="AA:22:33:44:55:AA"
             />

    </RelativeLayout>

</FrameLayout>